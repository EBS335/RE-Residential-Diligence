# Streamlit Cloud secrets — copy this file to .streamlit/secrets.toml locally,
# or paste the key-value pairs into the Streamlit Cloud "Secrets" settings panel.
# Never commit the real secrets.toml to source control.

GOOGLE_MAPS_API_KEY = "your_google_maps_key_here"
RENTCAST_API_KEY    = "your_rentcast_key_here"
RAPIDADPI_KEY        = "your_rapidapi_key_here"
