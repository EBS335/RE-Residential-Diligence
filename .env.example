# ── Geocoding (optional but recommended) ──────────────────────────────────────
# Enables the most accurate address resolution.
# Falls back to free OpenStreetMap Nominatim if not set.
# Get a key: https://console.cloud.google.com → APIs & Services → Geocoding API
GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# ── Rentcast (required for Stage 2 — rental listings) ─────────────────────────
# Free tier: 50 requests/month. Get a key: https://app.rentcast.io/app/api-keys
RENTCAST_API_KEY=your_rentcast_key_here

# ── RapidAPI / Zillow (required for Stage 2 — supplemental listings) ──────────
# Subscribe to "Zillow Com1" at https://rapidapi.com
RAPIDAPI_KEY=your_rapidapi_key_here
