# RentCast API (required for live rental listings)
# Get a free key at https://app.rentcast.io/app/api-keys
RENTCAST_API_KEY=your_rentcast_api_key_here

# Google Maps Geocoding API (optional — improves address accuracy)
# Falls back to OpenStreetMap Nominatim if not provided
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
